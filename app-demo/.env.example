# Copy to .env.local for local development. Locally, everything is optional:
# without these, the app uses ./data (SQLite, uploads, generated secrets) and
# only the demo account can sign in. On Vercel, set them in
# Project → Settings → Environment Variables. See docs/deployment.md.

# ── Database (required on Vercel) ────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Photo storage (required on Vercel for uploads) ───────────────────────────
# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
# Optional: "public" or "private" to skip auto-detecting the store type.
# BLOB_ACCESS=

# ── Secrets (required on Vercel) ─────────────────────────────────────────────
# Long random values, e.g. `openssl rand -hex 32`. Never change
# PHONE_HASH_PEPPER after launch, or existing phone blocks stop matching.
SESSION_SECRET=
PHONE_HASH_PEPPER=

# ── Sign-in emails (see docs/email.md) ───────────────────────────────────────
SMTP_HOST=smtppro.zohocloud.ca
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to TLS on port 465, STARTTLS otherwise.
# SMTP_SECURE=true
# Optional: defaults to "Sidekick <SMTP_USER>".
# EMAIL_FROM=
# Alternative to SMTP: Resend (used only when SMTP_* are not set).
# RESEND_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated, exact match. Default: my.yorku.ca
# ALLOWED_EMAIL_DOMAINS=my.yorku.ca
# Canonical site URL for metadata and the sitemap. Default: https://www.trysidekick.ca
# NEXT_PUBLIC_SITE_URL=
